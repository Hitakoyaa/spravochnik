{
  "name": "Справочник экономиста",
  "short_name": "Справочник",
  "description": "Остатки, разнарядки, выработка, персонал и штатка ТОО «Урожай» — без интернета",
  "lang": "ru",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F3F1EA",
  "theme_color": "#2E6B4E",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "archive",
          "accept": [
            "application/zip",
            "application/x-zip-compressed",
            "application/octet-stream",
            ".zip"
          ]
        }
      ]
    }
  }
}
